        <xs:sequence>
          <xs:element ref="nc:PhysicalFeatureCategoryAbstract" minOccurs="0" maxOccurs="10"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
