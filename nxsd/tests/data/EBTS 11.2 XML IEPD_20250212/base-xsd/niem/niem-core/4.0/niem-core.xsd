          <xs:element ref="nc:PersonCitizenshipAbstract" minOccurs="0" maxOccurs="10"/>
          <xs:element ref="nc:PersonEyeColorAbstract" minOccurs="0" maxOccurs="1"/>
          <xs:element ref="nc:PersonHairColorAbstract" minOccurs="0" maxOccurs="1"/>
