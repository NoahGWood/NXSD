				</xsd:annotation>
			</xsd:enumeration>

			<xsd:enumeration value="9">
				<xsd:annotation>
					<xsd:documentation>DHS IDENT</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>

			<xsd:enumeration value="10">
				<xsd:annotation>
					<xsd:documentation>DHS IDENT and LESC</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="11">
				<xsd:annotation>
					<xsd:documentation>RISC Wants and Warrants (W&amp;W)</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="12">
				<xsd:annotation>
					<xsd:documentation>RISC Sexual Offender Registry (SOR)</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
