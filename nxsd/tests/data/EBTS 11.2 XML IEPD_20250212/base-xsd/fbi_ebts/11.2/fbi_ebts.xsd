	<xsd:complexType name="MinutiaPolygonalVerticesPositionsType">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>A data type that represents the Cartesian positions defining the
				vertices of a polygon that bounds the region of the image from which the
				characterization products have been extracted.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="biom:PositionPolygonVertex" minOccurs="3" maxOccurs="20"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="MinutiaeReadingSystemType">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>A data type for describing the characterization equipment and the
				amount of manual intervention employed in the fingerprint characterization
				process</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:ReadingSystemName" minOccurs="0" maxOccurs="1"/>
					<xsd:element ref="ebts:ReadingSystemSubsystemID" minOccurs="0" maxOccurs="1"/>
					<xsd:element ref="ebts:ReadingSystemCodingMethodCode" minOccurs="0" maxOccurs="1"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="MinutiaPositionType">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>A data type used to define minutia attribute
				position.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:PositionDirectionDegreeValue" maxOccurs="3"/>
					<xsd:element ref="biom:PositionHorizontalCoordinateValue"/>
					<xsd:element ref="ebts:PositionUncertaintyValue"/>
					<xsd:element ref="biom:PositionVerticalCoordinateValue"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="MinutiaRidgeCountType">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>A data type for an extension of biom:MinutiaRidgeCountType in order
				to add additional extended location information.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="biom:MinutiaRidgeCountType">
				<xsd:sequence>
					<xsd:element ref="ebts:MinutiaOctantNumeric"/>
					<xsd:element ref="ebts:MinutiaOctantResidualNumeric" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="MinutiaeType">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>A data type for a representation of the FBI-Specific fingerprint
				minutiae information.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="biom:MinutiaeFingerPositionCode" minOccurs="0"/>
					<xsd:element ref="ebts:MinutiaeFBIStandard" minOccurs="0"/>
					<xsd:element ref="ebts:MinutiaCoordinateOffsets" minOccurs="0"/>
					<xsd:element ref="ebts:MinutiaPolygonalVerticesPositions" minOccurs="0"/>
					<xsd:element ref="ebts:MinutiaeFingerCoreAttributePosition" minOccurs="0"
						maxOccurs="2"/>
					<xsd:element ref="ebts:MinutiaeFingerDeltaAttributePosition" minOccurs="0"
						maxOccurs="2"/>
					<xsd:element ref="ebts:MinutiaeFingerPattern" minOccurs="0" maxOccurs="3"/>
					<xsd:element ref="ebts:MinutiaCharacterizationQualityValue" minOccurs="0"/>
					<xsd:element ref="ebts:MinutiaClassifierQualityValue" minOccurs="0"/>
					<xsd:element ref="ebts:PositionUncertaintyValue" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:simpleType name="MNTCodeSimpleType">
		<xsd:annotation>
			<xsd:documentation>A data type for an enumeration of minutiae type designation
				codes.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="A">
				<xsd:annotation>
					<xsd:documentation>Ridge ending</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="B">
				<xsd:annotation>
					<xsd:documentation>Ridge bifurcation</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="C">
				<xsd:annotation>
					<xsd:documentation>Ridge ending or bifurcation, no distinction
						provided</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="D">
				<xsd:annotation>
					<xsd:documentation>Type other than ending or bifurcation</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:complexType name="MNTCodeType">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>A data type for a representation of minutiae type designation
				codes.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="ebts:MNTCodeSimpleType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>

	<xsd:simpleType name="MNUCodeSimpleType">
		<xsd:annotation>
			<xsd:documentation>A data type for an enumeration of the type of FBI-specific MNU
				identification category codes.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="IO">
				<xsd:annotation>
					<xsd:documentation>Identification Order Number</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="BF">
				<xsd:annotation>
					<xsd:documentation>Bureau Fugitive Index Number</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="OA">
				<xsd:annotation>
					<xsd:documentation>Originating Agency Police or Identification
						Number</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="MNUUnionCodeSimpleType">
		<xsd:annotation>
			<xsd:documentation>A data type for a union of EBTS and FBI MNU code
				lists.</xsd:documentation>
		</xsd:annotation>
		<xsd:union memberTypes="ebts:MNUCodeSimpleType fbi:MNUCodeSimpleType"/>
	</xsd:simpleType>

	<xsd:complexType name="MNUCodeType">
		<xsd:annotation>
			<xsd:documentation>A data type for a representation of the type of MNU identification
				category codes.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="ebts:MNUUnionCodeSimpleType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<!--N-->

	<xsd:simpleType name="NDRCodeSimpleType">
		<xsd:annotation>
			<xsd:documentation>A data type for an enumeration of the code designation of FBI
				repositories.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="1">
				<xsd:annotation>
					<xsd:documentation>Criminal Master File Records</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="2">
				<xsd:annotation>
					<xsd:documentation>Civil Records</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="3">
				<xsd:annotation>
					<xsd:documentation>Unsolved Latent File</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="4">
				<xsd:annotation>
					<xsd:appinfo>
						<i:Deprecated i:value="true"/>
					</xsd:appinfo>
					<xsd:documentation>Reserved for FBI Use</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="5">
				<xsd:annotation>
					<xsd:appinfo>
						<i:Deprecated i:value="true"/>
					</xsd:appinfo>
					<xsd:documentation>Reserved for FBI Use</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="6">
				<xsd:annotation>
					<xsd:documentation>Repository for Individuals of Special
