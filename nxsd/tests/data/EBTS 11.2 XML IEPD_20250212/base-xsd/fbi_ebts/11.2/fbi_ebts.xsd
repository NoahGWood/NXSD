	<xsd:simpleType name="RBMICodeSimpleType">
		<xsd:annotation>
			<xsd:documentation>A data type for an enumeration representation of codes for record Rap
				Back record maintenance.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="R">
				<xsd:annotation>
					<xsd:documentation>Replace Rap Back Subscription data on file with that provided
						in the request</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="D">
				<xsd:annotation>
					<xsd:documentation>Delete Rap Back subscription data provided in request that
						matches what is on file</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="A">
				<xsd:annotation>
					<xsd:documentation>Append Rap Back subscription data provided in request to that
						on file</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="C">
				<xsd:annotation>
					<xsd:documentation>Cancel the Rap Back subscription</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="N">
				<xsd:annotation>
					<!-- Not Currently Used -->
					<xsd:documentation>Renew the Rap Back subscription</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="U">
				<xsd:annotation>
					<xsd:documentation>Un-cancel a cancelled Rap Back
						subscription</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>

