			<xsd:extension base="nc:IdentificationType">
				<xsd:sequence>
					<xsd:element ref="ebts:PersonIDCategoryCode"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

