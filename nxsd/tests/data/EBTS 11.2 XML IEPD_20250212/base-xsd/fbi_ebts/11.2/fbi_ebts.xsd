	<xsd:simpleType name="PercentageSimpleType">
		<xsd:annotation>
			<xsd:documentation>A data type for a whole percent from 0% to 99 %</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:integer">
			<xsd:minInclusive value="0"/>
			<xsd:maxInclusive value="99"/>
		</xsd:restriction>
	</xsd:simpleType>

