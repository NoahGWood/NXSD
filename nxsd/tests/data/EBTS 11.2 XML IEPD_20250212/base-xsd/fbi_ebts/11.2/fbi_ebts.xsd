	<xsd:complexType name="PersonFingerprintSetType">
		<xsd:annotation>
			<xsd:documentation>A data type for a representation of the identifying characteristics
				of the set of fingerprints of a person.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:FingerprintImageFingerMissing" minOccurs="0"
						maxOccurs="13"/>
					<xsd:element ref="ebts:FingerprintImageFinger" minOccurs="0" maxOccurs="10"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="PersonMeasurementType">
		<xsd:annotation>
			<xsd:documentation>A type for recording actual and estimated measurements of a
				person.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:choice>
						<xsd:element ref="nc:MeasureIntegerRange"/>
						<xsd:element ref="nc:MeasureIntegerValue"/>
					</xsd:choice>
					<xsd:element ref="nc:MeasureUnitText"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

