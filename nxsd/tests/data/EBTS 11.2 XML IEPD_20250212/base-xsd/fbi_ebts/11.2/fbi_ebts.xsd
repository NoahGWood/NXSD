	<xsd:simpleType name="NDRUnionCodeSimpleType">
		<xsd:annotation>
			<xsd:documentation>A data type for a union of NDR code lists.</xsd:documentation>
		</xsd:annotation>
		<xsd:union memberTypes="ebts:NDRReservedCodeSimpleType ebts:NDRCodeSimpleType"/>
	</xsd:simpleType>

	<xsd:simpleType name="NDRReservedCodeSimpleType">
		<xsd:annotation>
			<xsd:documentation>A data type for a designation of reserved repository codes. The value
				16 is reserved for internal FBI use The value ranges 17-19, 51-100 and 700-999 are
				reserved for future FBI use (ie, not valid at this time) The value range 20-50 is
				reserved for the Department of Defense. The value range 101-199 is reserved for FBI
				or Other Federal Organization Special Population Cognizant Files. The value range
				200-399 is reserved for State/Local Systems. The value range 400-699 is reserved for
				external FBI Agency use.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:integer">
			<xsd:pattern value="[1][6]|[1][0-9][1-9]|[1][1-9][0]|[2-6][0-9][0-9]|[2-4][0-9]|[5][0]"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:complexType name="NDRCodeType">
		<xsd:annotation>
			<xsd:documentation>A data type for a designation of the biometric
				repository</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="ebts:NDRUnionCodeSimpleType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>

