	<xsd:complexType name="PersonEmploymentType">
		<xsd:annotation>
			<xsd:documentation>A type to describe a person's employment
				information</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="nc:EmployeeOccupationText" minOccurs="0"/>
					<xsd:element ref="nc:OrganizationName" minOccurs="0"/>
					<xsd:element ref="nc:Address" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
