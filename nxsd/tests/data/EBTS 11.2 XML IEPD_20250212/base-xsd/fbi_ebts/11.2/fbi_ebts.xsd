<xsd:schema version="11.1"
	ct:conformanceTargets="http://reference.niem.gov/niem/specification/naming-and-design-rules/4.0/#ExtensionSchemaDocument"
	xmlns:ct="http://release.niem.gov/niem/conformanceTargets/3.0/"
	xmlns:ebts="http://cjis.fbi.gov/fbi_ebts/11.2"
	xmlns:s="http://release.niem.gov/niem/structures/4.0/"
	xmlns:itl="http://biometrics.nist.gov/standard/2011"
	xmlns:biom="http://publication.niem.gov/niem/domains/biometrics/4.0/1/"
	xmlns:nc="http://release.niem.gov/niem/niem-core/4.0/"
	xmlns:niem-xs="http://release.niem.gov/niem/proxy/xsd/4.0/"
	xmlns:fbi="http://release.niem.gov/niem/codes/fbi_ncic/4.0/"
	xmlns:i="http://release.niem.gov/niem/appinfo/4.0/"
	xmlns:j="http://release.niem.gov/niem/domains/jxdm/6.0/"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
	targetNamespace="http://cjis.fbi.gov/fbi_ebts/11.2">
	<xsd:annotation>
		<xsd:appinfo>
			<i:ConformantIndicator>true</i:ConformantIndicator>
		</xsd:appinfo>
		<xsd:documentation>The FBI Electronic Biometrics Transmission Specification XML data type complex content.</xsd:documentation>
	</xsd:annotation>

	<xsd:import namespace="http://release.niem.gov/niem/appinfo/4.0/"
		schemaLocation="../../niem/utility/appinfo/4.0/appinfo.xsd"/>
	<xsd:import namespace="http://publication.niem.gov/niem/domains/biometrics/4.0/1/"
		schemaLocation="../../niem/domains/biometrics/4.0/1/biom.xsd"/>
	<xsd:import namespace="http://release.niem.gov/niem/codes/fbi_ncic/4.0/"
		schemaLocation="../../niem/codes/fbi_ncic/4.0/fbi_ncic.xsd"/>
	<xsd:import namespace="http://release.niem.gov/niem/niem-core/4.0/"
		schemaLocation="../../niem/niem-core/4.0/niem-core.xsd"/>
	<xsd:import namespace="http://release.niem.gov/niem/proxy/xsd/4.0/"
		schemaLocation="../../niem/proxy/xsd/4.0/xs.xsd"/>
	<xsd:import namespace="http://release.niem.gov/niem/structures/4.0/"
		schemaLocation="../../niem/utility/structures/4.0/structures.xsd"/>
	<xsd:import namespace="http://release.niem.gov/niem/domains/jxdm/6.0/"
		schemaLocation="../../niem/domains/jxdm/6.0/jxdm.xsd"/>
	<xsd:import namespace="http://biometrics.nist.gov/standard/2011"
		schemaLocation="../../itl/itl.xsd">
		<xsd:annotation>
			<xsd:appinfo>
				<i:ConformantIndicator>false</i:ConformantIndicator>
			</xsd:appinfo>
			<xsd:documentation>ANSI/NIST-ITL Biometric Information Exchange Package Data
				Model.</xsd:documentation>
		</xsd:annotation>
	</xsd:import>

	<!--****************************************-->
	<!--****************************************-->

	<!--EBTS Type Definitions-->

	<!--11/30/22 Added POB codes from NCIC TOUs since initial publication of EBTS 11-->
	<!-- 11/30/22 Added BNO Codes for Field 10.350  				   -->
	<!-- 12/5/22 Added BNO field and supporting types				 -->
	<!--  12/9/22 Removed POB codes no longer in use 				-->

	<!--****************************************-->
	<!--****************************************-->

	<!--A-->

	<xsd:simpleType name="ArrestDateSuffixSimpleType">
		<xsd:annotation>
			<xsd:documentation>A code representing the sequence of the subject's arrests within a
				given date and the type of fingerprint card on which the Date of Arrest was
				contained.</xsd:documentation>
			<xsd:documentation>Values for public: L,R,V,W,X,and Y</xsd:documentation>
			<xsd:documentation>L - OFF Date Date of Offense (Suffix)</xsd:documentation>
			<xsd:documentation>R - Date FP Date Fingerprinted</xsd:documentation>
			<xsd:documentation>V - PRT Rec Date Print Received</xsd:documentation>
			<xsd:documentation>W - PRT Rec Date Print Received</xsd:documentation>
			<xsd:documentation>X - PRT Rec Date Print Received</xsd:documentation>
			<xsd:documentation>Y - APL Date Date of Application</xsd:documentation>
			<xsd:documentation>All Other values are for Internal Use Only.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[A-Z]"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:complexType name="ArrestDateSuffixType">
		<xsd:annotation>
			<xsd:documentation>A type representing the sequence of the subject's arrests within a
				given date and the type of fingerprint card on which the Date of Arrest was
				contained.</xsd:documentation>
			<xsd:documentation>Values for public use: L,R,V,W,X,and Y.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="ebts:ArrestDateSuffixSimpleType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>

	<xsd:complexType name="ArrestOffenseDataType">
		<xsd:annotation>
			<xsd:documentation>A data type for an arrest information container, relating to a
				Subject for a particular Arrest</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:OffenseDate" minOccurs="0"/>
					<xsd:element ref="j:ChargeText"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="AuditTrailRecordType">
		<xsd:annotation>
			<xsd:documentation>A data type for containing information associated with the
				dissemination of a Record owner's image</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:RecordReceivingAgency"/>
					<xsd:element ref="ebts:RecordDisseminationDate"/>
					<xsd:element ref="ebts:RecordTransactionCategoryCode"/>
					<xsd:element ref="ebts:BiometricSetID" minOccurs="0"/>
					<xsd:element ref="ebts:BiometricImageCategoryCode" minOccurs="0"/>
					<xsd:element ref="ebts:FrictionRidgePositionCode" minOccurs="0"/>
					<xsd:element ref="ebts:PrintPositionDescriptors" minOccurs="0"/>
					<xsd:element ref="biom:FaceImageSubjectPoseCode" minOccurs="0"/>
					<xsd:element ref="ebts:PhysicalFeatureCategoryCode" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="AuditTrailRecordListType">
		<xsd:annotation>
			<xsd:documentation>A data type for representing a list of records containing information
				associated with the dissemination of the Record owner's images</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:AuditTrailRecord" maxOccurs="100"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<!--B-->

	<xsd:simpleType name="BNOCategoryCodeSimpleType">
		<xsd:annotation>
			<xsd:documentation>A data type for an enumeration of NCIC Offense codes required to justify
				retention of a biometric as an unsolved case. </xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="0999 Homicide">
				<xsd:annotation>
					<xsd:documentation>Homicide</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="1099 Kidnapping">
				<xsd:annotation>
					<xsd:documentation>Kidnapping</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="1199 Sexual Assault">
				<xsd:annotation>
					<xsd:documentation>Sexual Assault</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="1299 Robbery">
				<xsd:annotation>
					<xsd:documentation>Robbery</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="1399 Assault">
				<xsd:annotation>
					<xsd:documentation>Assault</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="2699 Sex Offense">
				<xsd:annotation>
					<xsd:documentation>Sex Offense</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="6499 Exploitation">
				<xsd:annotation>
					<xsd:documentation>Exploitation</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:complexType name="BNOCategoryCodeType">
		<xsd:annotation>
			<xsd:documentation>A data type for an NCIC Offense code used to justify retention of a biometric as an unsolved case.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="ebts:BNOCategoryCodeSimpleType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>

	<xsd:simpleType name="BiometricImageCategoryCodeSimpleType">
		<xsd:annotation>
			<xsd:documentation>A data type for an enumeration of codes for the category of image
				included or requested in an electronic submittal</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="NOU">
				<xsd:annotation>
					<xsd:documentation>None and/or Unsolved</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="FP">
				<xsd:annotation>
					<xsd:documentation>Fingerprint (Event)</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="PP">
				<xsd:annotation>
					<xsd:documentation>Palm Print</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="SP">
				<xsd:annotation>
					<xsd:documentation>Supplemental Print</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="LFR">
				<xsd:annotation>
					<xsd:documentation>Latent Friction Ridge</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="CFP">
				<xsd:annotation>
					<xsd:documentation>Composite Fingerprint</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="PHF">
				<xsd:annotation>
					<xsd:documentation>Photo Facial</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="PSMT">
				<xsd:annotation>
					<xsd:documentation>Photo Scar, Mark and Tattoo</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="IRIS">
				<xsd:annotation>
					<xsd:documentation>Iris</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="FFPC">
				<xsd:annotation>
					<xsd:documentation>Fingerprints on Front of Palm Card</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="FBPC">
				<xsd:annotation>
					<xsd:documentation>Fingerprints on Back of Palm Card </xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="UFP">
				<xsd:annotation>
					<xsd:documentation>Unknown Facial Photo</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:complexType name="BiometricImageCategoryCodeType">
		<xsd:annotation>
			<xsd:documentation>A data type for a representation of codes for the category of image
				included or requested in an electronic submittal.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="ebts:BiometricImageCategoryCodeSimpleType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>

	<xsd:complexType name="BiometricImageDescriptionListType">
		<xsd:annotation>
			<xsd:documentation>A data type for representing a list of requested biometric
				images</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:BiometricImageDescription" maxOccurs="1000"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="BiometricImageDescriptionType">
		<xsd:annotation>
			<xsd:documentation>A data type for descriptively identifying a specific biometric
				image</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="j:PersonFBIIdentification" minOccurs="1"/>
					<xsd:element ref="ebts:BiometricImageCategoryCode" minOccurs="0"/>
					<xsd:element ref="ebts:BiometricSetID" minOccurs="0"/>
					<xsd:element ref="ebts:FrictionRidgePositionCode" minOccurs="0"/>
					<xsd:element ref="ebts:PrintPositionDescriptors" minOccurs="0"/>
					<xsd:element ref="biom:FaceImageSubjectPoseCode" minOccurs="0"/>
					<xsd:element ref="ebts:PhysicalFeatureCategoryCode" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="BiometricImageEnrollmentRecordListType">
		<xsd:annotation>
			<xsd:documentation>A data type for a list of information associated with the enrolled
				biometric images</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:BiometricImageEnrollmentRecord" maxOccurs="61"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="BiometricImageEnrollmentRecordType">
		<xsd:annotation>
			<xsd:documentation>A data type for a record containing information associated with the
				enrollment of an image</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:BiometricSetID" minOccurs="1"/>
					<xsd:element ref="ebts:BiometricImageCategoryCode" minOccurs="1"/>
					<xsd:element ref="biom:FaceImageSubjectPoseCode" minOccurs="0"/>
					<xsd:element ref="ebts:PhysicalFeatureCategoryCode" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<!--C-->
	<xsd:complexType name="CandidateType">
		<xsd:annotation>

			<xsd:documentation>A data type for containing information that identifies a person
				matched by the EBTS system returned in response to an inbound
				transaction.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="j:PersonFBIIdentification"/>
					<xsd:element ref="nc:PersonName" minOccurs="0"/>
					<xsd:element ref="ebts:BiometricSetID" minOccurs="0"/>
					<xsd:element ref="ebts:RecordBiometricImageCategoryCode" minOccurs="0"/>
					<xsd:element ref="ebts:FrictionRidgePositionCode" minOccurs="0"/>
					<xsd:element ref="ebts:PrintPositionDescriptors" minOccurs="0"/>
					<xsd:element ref="ebts:CandidateMatchScoreValue" minOccurs="0"/>
					<xsd:element ref="ebts:BiometricImageAvailableCode" minOccurs="0" maxOccurs="6"/>
					<xsd:element ref="ebts:RecordFBIRepositoryCode" minOccurs="0" maxOccurs="100"/>
					<xsd:element ref="biom:ImageReferenceID" minOccurs="0"/>
					<xsd:element ref="ebts:ORIPointOfContactText" minOccurs="0"/>
					<xsd:element ref="biom:FaceImageSubjectPoseCode" minOccurs="0"/>
					<xsd:element ref="ebts:PhysicalFeatureCategoryCode" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="CandidateImageType">
		<xsd:annotation>

			<xsd:documentation>A data type for containing information identifying the image type
				associated with the candidate.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="j:PersonFBIIdentification"/>
					<xsd:element ref="ebts:BiometricSetID"/>
					<xsd:element ref="ebts:CaptureDate"/>
					<xsd:element ref="ebts:RecordBiometricImageCategoryCode"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="CCTCodeType">
		<xsd:annotation>
			<xsd:documentation>A data type for a representation of the METHOD and degree of
				automation in the characterization process.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="ebts:CCTCodeSimpleType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>

	<xsd:simpleType name="CCTCodeSimpleType">
		<xsd:annotation>
			<xsd:documentation>A data type for a two-byte sequential number assigned to each court
				count, with the valid value range from 1-999.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:integer">
			<xsd:minInclusive value="1"/>
			<xsd:maxInclusive value="999"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:complexType name="ContributorCaseIdentificationNumberType">
		<xsd:annotation>

			<xsd:documentation>A data type for an identification of a contributor's latent
				case.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:ContributorCasePrefixText"/>
					<xsd:element ref="ebts:ContributorCaseID"/>
					<xsd:element ref="ebts:ContributorCaseExtensionID" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="CourtDispositionDataType">
		<xsd:annotation>
			<xsd:documentation>A data type for a disposition information container relating to a
				Subject for a particular Arrest</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:DispositionDate" minOccurs="0"/>
					<xsd:element ref="j:ChargeText"/>
					<xsd:element ref="nc:DispositionText"/>
					<xsd:element ref="ebts:DispositionCategoryCode"/>
					<xsd:element ref="ebts:CourtCountNumber" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="CriminalCycleType">
		<xsd:annotation>
			<xsd:documentation>A data type for an arrest information and associated disposition and
				supervised release information container, relating to a Subject for a particular
				Arrest</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:ArrestOffenseData" minOccurs="0"/>
					<xsd:element ref="ebts:CourtDispositionData" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:simpleType name="CSFCodeSimpleType">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>A data type for an enumeration of code values for cascaded
				searches.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="CR">
				<xsd:annotation>
					<xsd:documentation>Criminal File</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="CI">
				<xsd:annotation>
					<xsd:documentation>Civil File</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="BO">
				<xsd:annotation>
					<xsd:documentation>Both Criminal and Civil Files</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:complexType name="CSFCodeType">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>A data type for a representation of flags for a record that is to be
				subjected to cascaded searches.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="ebts:CSFCodeSimpleType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>

	<xsd:complexType name="CustodySupervisoryDataType">
		<xsd:annotation>
			<xsd:documentation>A data type for supervised release information relating to a subject
				for a particular arrest.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:StartDate" minOccurs="0"/>
					<xsd:element ref="ebts:EndDate" minOccurs="0"/>
					<xsd:element ref="ebts:SupervisionStatus" minOccurs="0"/>
					<xsd:element ref="ebts:SupervisedReleaseActionCode" minOccurs="0"/>
					<xsd:element ref="ebts:SupervisedReleaseRevocationReasonText" minOccurs="0"/>
					<xsd:element ref="ebts:SupervisionReceivingOrganizationID" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<!--D-->
	<xsd:complexType name="DateRangeType">
		<xsd:annotation>
			<xsd:documentation>A date range of full local dates</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:StartDate"/>
					<xsd:element ref="ebts:EndDate"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="DispositionCategoryCodeType">
		<xsd:annotation>
			<xsd:documentation>A data type for a text representation of the definitive disposition
				information about a subject for a particular charge.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="ebts:DispositionCategoryCodeSimpleType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>

	<xsd:simpleType name="DispositionCategoryCodeSimpleType">
		<xsd:annotation>
			<xsd:documentation>A data type for an enumeration of codes for the court
				disposition</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="CONVICTED">
				<xsd:annotation>
					<xsd:documentation>Judicial finding of guilty of a crime in adult court, by
						verdict or plea</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="ACQUITTED">
				<xsd:annotation>
					<xsd:documentation>Finding, by jury or judge, that a person is not guilty of the
						charged offense</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="DISMISSED">
				<xsd:annotation>
					<xsd:documentation>Decision by the court that terminates prosecution; limited to
						court actions only, including vacated, and stricken on leave, and set
						aside</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="CHARGES DROPPED">
				<xsd:annotation>
					<xsd:documentation>Use for arrest disposition only</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="NOT PROSECUTED">
				<xsd:annotation>
					<xsd:documentation>Use for events that end at the arrest, grand jury or
						prosecution phase - NOLLE PROSEQUI, NO BILL, NOT FILED, NO ACTION
						TAKEN</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="MENTAL HEALTH ADJUDICATION">
				<xsd:annotation>
					<xsd:documentation>Court action to suspend prosecution while determining
						competence to stand trial or a finding of not guilty by lack of mental
						responsibility</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="DIVERSION">
				<xsd:annotation>
					<xsd:documentation>Referral to a program intended to enable alleged offenders to
						avoid criminal charges and a criminal record</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="CONDITIONAL">
				<xsd:annotation>
					<xsd:documentation>Court outcome involving the absence of determination of
						guilt</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="JUVENILE ADJUDICATION">
				<xsd:annotation>
					<xsd:documentation>Court adjudication of delinquency or imposition of juvenile
						sanctions in adult court; not limited to felonies</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="REVOCATION">
				<xsd:annotation>
					<xsd:documentation>An annulment, cancellation or reversal of a finding of
						guilty</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="EXTRADITED">
				<xsd:annotation>
					<xsd:documentation>The official surrender of an alleged criminal by one
						jurisdiction to another; the return of a fugitive from justice, regardless
						of consent, by the authorities where the fugitive
						resides</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="TRANSFERRED">
				<xsd:annotation>
					<xsd:documentation>The removal of a case from the jurisdiction of one court
						judge to another</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="DEPORTED">
				<xsd:annotation>
					<xsd:documentation>The expulsion or transfer of an alien from the
						country</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="DECEASED">
				<xsd:annotation>
					<xsd:documentation>Subject charged is deceased</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="CONSOLIDATED">
				<xsd:annotation>
					<xsd:documentation>Court ordered unification of two or more charges or cases
						into a single matter</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="BAIL/BOND FORFEITURE">
				<xsd:annotation>
					<xsd:documentation>Money or property lost or confiscated by this process; a
						penalty</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="DEFERRED">
				<xsd:annotation>
					<xsd:documentation>Postponed or delayed, could relate to prosecution, sentence,
						judgement or disposition</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="UNAVAILABLE">
				<xsd:annotation>
					<xsd:documentation>This will be entered by the state repository if the final
						disposition is unavailable</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="DESTROYED">
				<xsd:annotation>
					<xsd:documentation>This will be entered by the state repository if the
						disposition could not be found due to destruction through a fire or a
						natural disaster</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="OTHER">
				<xsd:annotation>
					<xsd:documentation>If using OTHER it is mandatory to provide detail or
						description under the COL information item</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>

