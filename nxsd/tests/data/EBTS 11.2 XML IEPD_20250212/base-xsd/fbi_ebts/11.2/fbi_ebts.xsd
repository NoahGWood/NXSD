			<xsd:enumeration value="SRL">
				<xsd:annotation>
					<xsd:documentation>SEARCH RESULTS - LATENT</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="SRNR">
				<xsd:annotation>
					<xsd:documentation>SUPERVISED RELEASE NOTIFICATION REQUEST</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="SRNRR">
				<xsd:annotation>
					<xsd:documentation>SUPERVISED RELEASE NOTIFICATION RESPONSE</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="SRT">
				<xsd:annotation>
					<xsd:documentation>SEARCH RESULTS - TENPRINT</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="TPIS">
				<xsd:annotation>
					<xsd:documentation>TENPRINT FINGERPRINT IMAGE SEARCH</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="TPRR">
				<xsd:annotation>
					<xsd:documentation>TENPRINT RAP SHEET RESPONSE</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="TPRS">
				<xsd:annotation>
					<xsd:documentation>TENPRINT RAP SHEET SEARCHES</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="TXTSRCH">
				<xsd:annotation>
					<xsd:documentation>TEXT BASED PHOTO/SMT SEARCH REQUEST</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="UBM">
				<xsd:annotation>
					<xsd:documentation>UNSOLVED BIOMETRIC MATCH</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="UHN">
				<xsd:annotation>
					<xsd:documentation>UNSOLICTED HIT NOTIFICATION</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="ULD">
				<xsd:annotation>
					<xsd:documentation>UNSOLVED LATENT RECORD DELETE</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="ULDR">
				<xsd:annotation>
					<xsd:documentation>UNSOLVED LATENT DELETE RESPONSE</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="ULM">
				<xsd:annotation>
					<xsd:documentation>UNSOLVED LATENT MATCH RESPONSE</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="UUBD">
				<xsd:annotation>
					<xsd:documentation>UNSOLICITED UNSOLVED BIOMETRIC DELETE</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="UULD">
				<xsd:annotation>
					<xsd:documentation>UNSOLICITED UNSOLVED LATENT DELETE</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="XACT">
				<xsd:annotation>
					<xsd:documentation>EXTERNAL SYSTEM LINK ACTIVITY REQUEST</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="XACTR">
				<xsd:annotation>
					<xsd:documentation>EXTERNAL SYSTEM LINK ACTIVITY RESPONSE</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="XMNT">
				<xsd:annotation>
					<xsd:documentation>EXTERNAL SYSTEM</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="XMNTR">
				<xsd:annotation>
					<xsd:documentation>EXTERNAL SYSTEM LINK MAINTENANCE RESPONSE</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:complexType name="TOTCodeType">
		<xsd:annotation>

			<xsd:documentation>A data type for an representation of the type of
				transaction.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="ebts:TOTCodeSimpleType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>

	<xsd:complexType name="TransactionCandidateImageListType">
		<xsd:annotation>

			<xsd:documentation>A data type for a representation of a list of potential match
				candidates.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:CandidateImage" maxOccurs="1000"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="TransactionCandidateListType">
		<xsd:annotation>

			<xsd:documentation>A data type for a representation of a list of potential match
				candidates.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:Candidate" maxOccurs="99"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="TransactionFingerprintImagesType">
		<xsd:annotation>
			<xsd:documentation>A data type for an encoding of values representing the finger numbers
				for which image information is requested.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:choice>
						<xsd:element ref="ebts:FrictionRidgePositionCode" minOccurs="1"
							maxOccurs="13"/>
						<xsd:element ref="ebts:FrictionRidgeExceptionCode"/>
					</xsd:choice>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:simpleType name="TransactionHitCategoryCodeSimpleType">
		<xsd:annotation>
			<xsd:documentation>A data type for an enumeration of the type of transaction hit
				codes.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="FSI">
				<xsd:annotation>
					<xsd:documentation>Result activity on an FSI Identity</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="RISC">
				<xsd:annotation>
					<xsd:documentation>Hit Repository of Individuals of Special Concern (RISC)
						Record</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="SUPV REL">
				<xsd:annotation>
					<xsd:documentation>Result of activity on a Supervised Release
						Subject</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:complexType name="TransactionHitCategoryCodeType">
		<xsd:annotation>

			<xsd:documentation>A data type for a representation of the type of hit found by a
				transaction.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="ebts:TransactionHitCategoryCodeSimpleType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>

	<xsd:complexType name="TransactionResponseDataType">
		<xsd:annotation>

			<xsd:documentation>A data type for a Response section of an EBTS
				Message.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:BiometricImageList" minOccurs="0"/>
					<xsd:element ref="ebts:TransactionHitCategoryCode" minOccurs="0"/>
					<xsd:element ref="ebts:TransactionReasonText" minOccurs="0"/>
					<xsd:element ref="ebts:TransactionActionText" minOccurs="0"/>
					<xsd:element ref="ebts:TransactionAuditTrailRecordList" minOccurs="0"/>
					<xsd:element ref="ebts:TransactionCandidateList" minOccurs="0" maxOccurs="3"/>
					<xsd:element ref="ebts:TransactionPenetrationQueryResponsePercent" minOccurs="0"/>
					<xsd:element ref="ebts:TransactionRepositoryResponse" minOccurs="0"/>
					<xsd:element ref="ebts:TransactionResponseIndicator" minOccurs="0"/>
					<xsd:element ref="ebts:TransactionSearchResultsCode" minOccurs="0"/>
					<xsd:element ref="ebts:TransactionStatusText" minOccurs="0" maxOccurs="1000"/>
					<xsd:element ref="ebts:TransactionSupplementaryIdentityInformationText"
						minOccurs="0"/>
					<xsd:element ref="ebts:TransactionElectronicRapSheetText" minOccurs="0"/>
					<xsd:element ref="ebts:TransactionElectronicRapSheetXML" minOccurs="0"/>
					<xsd:element ref="ebts:TransactionBiometricImageEnrollmentRecordList"
						minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="TransactionRepositoryResponseRecordType">
		<xsd:annotation>
			<xsd:documentation>A data type for a detailing of statistics that can be used to
				estimate the level of penetration of the repository given a set of search parameters
				defined in the search request</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:RepositoryParameterText"/>
					<xsd:element ref="ebts:RepositoryParameterValueText"/>
					<xsd:element ref="ebts:RepositoryCriminalParameterRatio"/>
					<xsd:element ref="ebts:RepositoryCivilParameterRatio"/>
					<xsd:element ref="ebts:RepositoryCombinedParameterRatio"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="TransactionRepositoryResponseType">
		<xsd:annotation>
			<xsd:documentation>A data type for a detailing of statistics that can be used to
				estimate the level of penetration of the repository given a set of search parameters
				defined in the search request</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:TransactionRepositoryResponseRecord"
						maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:simpleType name="TSRCodeSimpleType">
		<xsd:annotation>
			<xsd:documentation>A data type for an encoding of the type of record being
				submitted.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="C">
				<xsd:annotation>
					<xsd:documentation>Confidential Screening</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="H">
				<xsd:annotation>
					<xsd:documentation>Suppress/Modify Unsolicited Want/SOR Notification (Non-Urgent
						Criminal)</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="P">
				<xsd:annotation>
					<xsd:documentation>Pre-commission candidate record with
						fingerprints</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="V">
				<xsd:annotation>
					<xsd:documentation>Civil submission in support of the National Child Protection
						Act of 1993</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:complexType name="TSRCodeType">
		<xsd:annotation>

			<xsd:documentation>A data type for an indication of the type of record being
				submitted.</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="ebts:TSRCodeSimpleType">
				<xsd:attributeGroup ref="s:SimpleObjectAttributeGroup"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<!--U-->
	<xsd:complexType name="UserDefinedElementType">
		<xsd:annotation>
			<xsd:documentation>A data type for a user-defined element pair.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:UserDefinedElementName"/>
					<xsd:element ref="ebts:UserDefinedElementText"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="UserDefinedFieldsType">
		<xsd:annotation>
			<xsd:documentation>A data type for a representation of State Agency-specific data not
				otherwise required by the FBI</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="nc:OrganizationName"/>
					<xsd:any minOccurs="1" maxOccurs="unbounded" processContents="skip"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="UserDefinedFaceInformationType">
		<xsd:annotation>
			<xsd:documentation>A data type for including user-defined elements for Facial Image transactions</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:BiometricNCICOffenseCode"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="UserDefinedFrictionRidgeInformationType">
		<xsd:annotation>
			<xsd:documentation>A data type for including user-defined elements for fingerprint and
				supplemental transactions</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="s:ObjectType">
				<xsd:sequence>
					<xsd:element ref="ebts:ImageSourceCode"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<!--V-->
	<!--W-->
	<!--X-->
	<!--Y-->
	<!--Z-->

	<!--****************************************-->
	<!--****************************************-->
	<!--****************************************-->

	<!--EBTS Element Declarations-->

	<!--****************************************-->
	<!--****************************************-->
	<!--****************************************-->

	<!--a-->
	<xsd:element name="AFISSegmentControlID" type="niem-xs:string" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An id used by AFIS/FBI to allow tracking of or reference to specific
				transactions.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="ArrestDate" type="niem-xs:date">
		<xsd:annotation>
			<xsd:documentation>A local date that a Subject was arrested</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="ArrestDateSuffixCode" type="ebts:ArrestDateSuffixType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element representing the sequence of the subject's arrests within
				a given date and the type of fingerprint card on which the Date of Arrest was
				contained.</xsd:documentation>
			<xsd:documentation>Values allowed for external use, by prior arrangement with the FBI:
				L, R, V, W, X, and Y.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="ArrestOffenseData" type="ebts:ArrestOffenseDataType">
		<xsd:annotation>
			<xsd:documentation>A container for the arrest information about a Subject for a
				particular Arrest</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="AuditTrailRecord" type="ebts:AuditTrailRecordType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element for containing information associated with the
				dissemination of a Record owner's image</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<!--b-->
	<xsd:element name="BinaryCODISAvailableIndicator" type="niem-xs:boolean" nillable="true">
		<xsd:annotation>
			<xsd:documentation>True if the DNA available is located in the CODIS database for the
				subject identified on the CAR, CNA, and CPNU TOTs, false
				otherwise.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="BiometricImageAvailableCode" type="ebts:BiometricImageCategoryCodeType">
		<xsd:annotation>
			<xsd:documentation> An element listing a kind biometric image available for a given
				subject.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="BiometricImageCategoryCode" type="ebts:BiometricImageCategoryCodeType"
		nillable="true">
		<xsd:annotation>
			<xsd:documentation>A kind of biometric image.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="BiometricImageDescription" type="ebts:BiometricImageDescriptionType">
		<xsd:annotation>
			<xsd:documentation>A description to allow positive identification of a specific
				biometric image</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="BiometricImageEnrollmentRecord"
		type="ebts:BiometricImageEnrollmentRecordType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A record containing information associated with the enrollment of an
				image</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="BiometricImageList" type="ebts:TransactionCandidateImageListType">
		<xsd:annotation>
			<xsd:documentation>An element that represents a candidate list that provides biometric
				capture dates for all facial and SMT photos for each subject.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="BiometricNCICOffenseCode" type="ebts:BNOCategoryCodeType">
		<xsd:annotation>
			<xsd:documentation>An element that provides the NCIC Offense used to justify retention of a biometric as an unsolved case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="BiometricSetID" type="niem-xs:string" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An identifier to uniquely identify a fingerprint set, palm print set,
				or a supplemental print set</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<!--c-->
	<xsd:element name="Candidate" type="ebts:CandidateType">
		<xsd:annotation>
			<xsd:documentation>An identification of a person matched by the EBTS system returned in
				response to an inbound transaction.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="CandidateImage" type="ebts:CandidateImageType">
		<xsd:annotation>
			<xsd:documentation>An identification of the necessary identifiers to retrieve facial and
				SMT photos for a subject in the candidate list.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="CandidateMatchScoreValue" type="niem-xs:nonNegativeInteger" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A number that represents the match score of a fingerprint from AFIS
				for a candidate list response.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="CaptureDate" type="niem-xs:date">
		<xsd:annotation>
			<xsd:documentation>A local date that indicates when a set of biometrics was
				captured</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="ChargeText" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of the charges filed against a
				subject</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="ContributorAssignedNumberID" type="niem-xs:string" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An identifier assigned to a single biographic search by the
				contributor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="ContributorCaseID" type="niem-xs:string" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An identifier assigned by the contributor to uniquely identify a
				latent case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="ContributorCaseIdentificationNumber"
		type="ebts:ContributorCaseIdentificationNumberType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element that contains identification information assigned by the
				contributor.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="ContributorCasePrefixText" type="niem-xs:string" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of the Contributor Case number.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="ContributorCaseExtensionID" type="niem-xs:string" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An identifier that supplements the Case Identifier Number, allowing
				multiple searches to be associated with the same case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="CourtCountNumber" type="ebts:CCTCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An identification of a court count.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="CourtDispositionData" type="ebts:CourtDispositionDataType">
		<xsd:annotation>
			<xsd:documentation>A container for the court disposition information about a Subject for
				a particular Arrest</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="CriminalCycle" type="ebts:CriminalCycleType">
		<xsd:annotation>
			<xsd:documentation>A container for the arrest information and associated disposition and
				supervised release information about a Subject for a particular
				Arrest</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="CustodySupervisoryData" type="ebts:CustodySupervisoryDataType">
		<xsd:annotation>
			<xsd:documentation>A container for the supervised release information about a Subject
				for a particular Arrest</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<!--d-->

	<xsd:element name="DispositionCategoryCode" type="ebts:DispositionCategoryCodeType">
		<xsd:annotation>
			<xsd:documentation>A code to express the definitive disposition information about a
				Subject for a particular Arrest</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="DispositionDate" type="niem-xs:date">
		<xsd:annotation>
			<xsd:documentation>A local date to record the disposition of a
				charge</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="DNALocationORIID" type="niem-xs:string">
		<xsd:annotation>
			<xsd:documentation>An ID for an ORI holding a subject's DNA</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="DomainDefinedDescriptiveFields"
		type="ebts:DomainDefinedDescriptiveFieldsType"
		substitutionGroup="itl:DomainDefinedDescriptiveDetail">
		<xsd:annotation>
			<xsd:documentation>A logical data record containing fields which provide identification
				and descriptive information associated with the subject of the
				transaction.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<!--e-->
	<xsd:element name="EndDate" type="niem-xs:date">
		<xsd:annotation>
			<xsd:documentation>A local date that supervisory custody ends</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="EnrollmentEventID" type="niem-xs:string">
		<xsd:annotation>
			<xsd:documentation>An identifier to uniquely identify a specific enrollment event during
				FIS processing. An EVI may have multiple BSI sets associated with a specific
				event.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="ExternalSubjectID" type="niem-xs:string">
		<xsd:annotation>
			<xsd:documentation>An identification of a subject from an external system that
				represents a distinct Identity.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<!--f-->
	<xsd:element name="FBIFileNumberID" type="niem-xs:string" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An id representing the FBI Investigative File
				Number.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="FBILatentCaseIdentification" type="ebts:FBILatentCaseIdentificationType">
		<xsd:annotation>
			<xsd:documentation>An identification for a FBI latent case number.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="FBILatentCaseNumberID" type="niem-xs:string" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An identifier assigned by the FBI and used for record keeping
				purposes.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="FBILatentCaseNumberExtensionID" type="niem-xs:string" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An identifier that defines subsequent extensions assigned by the FBI
				for each submission related to a Latent Case Number.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="FingerprintImageFinger" type="ebts:FingerprintImageFingerType"
		nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element that contains information about a finger in an
				image.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FingerprintImageFingerMissing" type="ebts:FingerprintImageFingerMissingType"
		nillable="true">
		<xsd:annotation>
			<xsd:documentation>A missing finger in a fingerprint image</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FingerprintPatternClassificationCode" type="fbi:FPatternCodeType">
		<xsd:annotation>
			<xsd:documentation>A code for a Fingerprint Pattern Classification (FPC)
				value</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FrictionRidgeExceptionCode" type="ebts:FrictionRidgeExceptionCodeType">
		<xsd:annotation>
			<xsd:documentation>A code for indicating the condition when normal FGP codes do not
				apply</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FrictionRidgeInformation" type="ebts:FrictionRidgeInformationType">
		<xsd:annotation>
			<xsd:documentation>An element for friction ridge related information</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="FrictionRidgePositionCode" type="ebts:FrictionRidgePositionCodeType">
		<xsd:annotation>
			<xsd:documentation>An element that contains all EBTS-allowed friction ridge position
				codes, encompassing hands and feet</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ForeignInformationText" type="nc:TextType">
		<xsd:annotation>
			<xsd:documentation>A text field to describe the context of the collection of foreign
				fingerprint data.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<!--g-->
	<!--h-->
	<xsd:element name="HitNotificationRequestIndicator" type="niem-xs:boolean" nillable="true">
		<xsd:annotation>
			<xsd:documentation>True if a record should be marked for hit notification; false if a
				potential match against the associated record should not generate a
				UHN.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<!--i-->
	<xsd:element name="ImageSourceCode" type="ebts:ImageSourceCodeType">
		<xsd:annotation>
			<xsd:documentation>An element to indicate to which source the included image belongs,
				allowing images from multiple biometric sets that use the same record type to be
				distinguishable.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<!--j-->
	<!--k-->
	<!--l-->
	<xsd:element name="LocationStateCode" type="ebts:POBCodeType"
		substitutionGroup="nc:StateRepresentation">
		<xsd:annotation>
			<xsd:documentation>A code representing the country subdivision for a
				location</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<!--m-->
	<xsd:element name="MinutiaCharacterizationQualityValue" type="niem-xs:nonNegativeInteger">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>A number representing the distribution of the parameter over
				thousands of fingerprints approximating a Gaussian distribution.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="MinutiaClassifierQualityValue" type="niem-xs:decimal">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>A number that indicates the quality or confidence of the automatic
				classification.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="MinutiaCoordinateOffsets" type="ebts:MinutiaCoordinateOffsetsType"
		nillable="true">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>An element that allows the recording of translation, rotation, and
				image cropping employed in the minutia characterization process.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="MinutiaDetail" type="ebts:FBIMinutiaType" nillable="true">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>A representation of the minutia detail of a
				fingerprint.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="MinutiaOctantNumeric" type="niem-xs:integer">
		<xsd:annotation>
			<xsd:documentation>A number representing the octant containing
				Minutia.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="MinutiaOctantResidualNumeric" type="niem-xs:nonNegativeInteger">
		<xsd:annotation>
			<xsd:documentation>An element that indicates into which half of the octant minutia
				lies.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="MinutiaPolygonalVerticesPositions"
		type="ebts:MinutiaPolygonalVerticesPositionsType" nillable="true">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>An element that provides the Cartesian positions defining the
				vertices of a polygon that bounds the region of the image from which the
				characterization products have been extracted.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="MinutiaRidgeCount" type="ebts:MinutiaRidgeCountType">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>A description of Ridges between Minutia.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="MinutiaTypeCode" type="ebts:MNTCodeType" nillable="true">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>An element that indicates the minutiae type
				designation.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="Minutiae" type="ebts:MinutiaeType"
		substitutionGroup="biom:RecordMinutiaeAbstract" nillable="true">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>A representation of the minutiae of a
				fingerprint.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="MinutiaeFBIStandard" type="ebts:FBIStandardMinutiaeType" nillable="true">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>An element that represents the FBI Standard Minutiae
				data.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="MinutiaeFingerCoreAttributePosition" type="ebts:MinutiaPositionType"
		nillable="true">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>An element that indicates the attributes of a pattern core in a
				fingerprint.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="MinutiaeFingerDeltaAttributePosition" type="ebts:MinutiaPositionType"
		nillable="true">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>An element that indicates the position of a pattern delta in a
				fingerprint.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="MinutiaeFingerPattern" type="ebts:RidgeCoreDeltaType" nillable="true">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>An element that contains the AFIS/FBI Pattern Classification and the
				ridge count for the fingerprint minutiae.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="MinutiaeReadingSystem" type="ebts:MinutiaeReadingSystemType" nillable="true">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>An element that describes the characterization equipment and the
				amount of manual intervention employed in the characterization
				process.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<!--n-->
	<xsd:element name="NCICFingerprintClassificationCodeText" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element that indicates the fingerprint pattern classification
				codes as designated by NCIC.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<!--o-->
	<xsd:element name="OffenseCategoryCode" type="ebts:OFCCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code that indicates the type of offense.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="OffenseDate" type="niem-xs:date">
		<xsd:annotation>
			<xsd:documentation>A date of offense for a particular Arrest</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="OffsetCenterOfRotation" type="biom:VertexType" nillable="true">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>A set of coordinates that represents the center of rotation within
				the sub-image.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="OffsetTranslatedCenterOfRotation" type="biom:VertexType" nillable="true">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>A set of coordinates that represents the center of rotation in the
				rotated sub-image after the sub-image has been translated to eliminate negative
				column and row indexes.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="OffsetTranslatedUpperLeftCoordinates" type="biom:VertexType" nillable="true">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>A set of coordinates that represents the upper-left-corner column and
				row offsets to a cropped sub-image taken from the rotated image once adjusted to
				eliminate negative coordinate values.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="OffsetUpperLeftCoordinates" type="biom:VertexType" nillable="true">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>A set of coordinates that represents the offset to the
				upper-left-corner of a non-rotated sub-image used subsequently in image
				processing.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="ORIPointOfContactText" type="nc:TextType">
		<xsd:annotation>
			<xsd:documentation>An element providing free text ORI information when no image is
				available for candidate.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<!--p-->
	<xsd:element name="PersonAdultTreatmentIndicator" type="niem-xs:boolean">
		<xsd:annotation>
			<xsd:documentation>True if a juvenile is to be processed as an adult, false
				otherwise.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonAgeRange" type="nc:IntegerRangeType">
		<xsd:annotation>
			<xsd:documentation>An element for a Subject's Age range</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonAlternateName" type="nc:PersonNameType">
		<xsd:annotation>
			<xsd:documentation>An alternate name or alias of a person.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonBirthPlaceCode" type="ebts:POBCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code that indicates a person's place of birth</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonCitizenshipCode" type="ebts:POBCodeType"
		substitutionGroup="nc:PersonCitizenshipAbstract" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code that indicates a person's country of
				citizenship</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonDigitalImageAvailableIndicator" type="niem-xs:boolean">
		<xsd:annotation>
			<xsd:documentation>True if a digital image is available for the Subject, false
				otherwise.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonDNAAvailableIndicator" type="niem-xs:boolean">
		<xsd:annotation>
			<xsd:documentation>True if a DNA sample is available for the Subject, false
				otherwise.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonEmployment" type="ebts:PersonEmploymentType">
		<xsd:annotation>
			<xsd:documentation>An element to describe a person's employment
				information</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonEyeColorCode" type="ebts:EYECodeType"
		substitutionGroup="nc:PersonEyeColorAbstract">
		<xsd:annotation>
			<xsd:documentation>A color of the eyes of a person.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonFingerprintSet" type="ebts:PersonFingerprintSetType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A representation of the identifying characteristics of a person's set
				of fingerprints.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonFirearmSalesDisqualifiedCode" type="ebts:IFSCodeType">
		<xsd:annotation>
			<xsd:documentation>A status of person's eligibility to purchase
				firearms.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonHairColorCode" substitutionGroup="nc:PersonHairColorAbstract"
		type="biom:HairColorCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element that represents the larger set of ansi-nist person hair
				color codes.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonHeightMeasure" type="ebts:PersonMeasurementType">
		<xsd:annotation>
			<xsd:documentation>An element for height measurement of a person</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonIDCategoryCode" type="ebts:MNUCodeType">
		<xsd:annotation>
			<xsd:documentation>An element to indicate the category of Miscellaneous Identification
				provided for a Person</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonOtherIdentification" type="ebts:PersonOtherIdentificationType">
		<xsd:annotation>
			<xsd:documentation>An identification from a predefined list of
				sources</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonPalmPrintAvailableIndicator" type="niem-xs:boolean">
		<xsd:annotation>
			<xsd:documentation>True if a subject's palm print is available, false
				otherwise.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonPhysicalFeature" type="ebts:PhysicalFeatureType" substitutionGroup="nc:PersonPhysicalFeature" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element that contains information about a physical feature of a
				person.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonResidenceLocation" type="nc:LocationType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element that indicates the residence of Person
				Fingerprinted.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonSubmittedBirthDate" type="nc:DateType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A date of birth as provided in a submission that is determined to be
				different than the date of birth in the record of the identified
				subject.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonSubmittedName" type="nc:PersonNameType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A name as provided in a submission that is determined to be different
				than the name of record of an identified subject.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonTypeDesignatorCode" type="ebts:PTDCodeType" nillable="true">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>An element that indicates that the fingerprints belong to a victim,
				suspect, individual with legitimate access to the object, or other individuals
				involved in the latent case.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PersonWeightMeasure" type="ebts:PersonMeasurementType">
		<xsd:annotation>
			<xsd:documentation>An element for weight measurement of a person</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PhysicalFeatureCategoryCode" type="ebts:SMTCodeType"
		substitutionGroup="nc:PhysicalFeatureCategoryAbstract">
		<xsd:annotation>
			<xsd:documentation>A code for describing distinguishing physical characteristics of a
				person, such as a tattoo</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PointOfContactName" type="nc:TextType">
		<xsd:annotation>
			<xsd:documentation>A name of a contact organization or person.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PositionDirectionDegreeValue" type="nc:Degree360Type" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A direction of a core opening, through the center of curvature for
				the innermost recurve at maximum curvature in integer degrees (000 to
				360)</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PositionUncertaintyValue" type="niem-xs:nonNegativeInteger" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A radius of position uncertainty (PUM) in the manual or automatic
				placement of the core in integer units of 10 micrometers</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="PrintPositionDescriptors" type="ebts:PrintPositionDescriptorsType"
		nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of the probable area of the finger represented in a
				fingerprint image, to allow transactions to reference EJI or Tip
				images..</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<!--q-->
	<!--r-->

	<xsd:element name="RapBackDateRange" type="ebts:DateRangeType">
		<xsd:annotation>
			<xsd:documentation>An expiration date range for a rap back subscription
				search</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RapBackEventDate" type="niem-xs:date">
		<xsd:annotation>
			<xsd:documentation>A date that a Rap Back Triggering Event occurred.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RapBackEventText" type="nc:TextType">
		<xsd:annotation>
			<xsd:documentation>Information about a Rap Back Triggering Event.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RapBackTriggeringEventCode" type="ebts:RBTCodeType">
		<xsd:annotation>
			<xsd:documentation>A code identifying the type of Rap Back Triggering
				Event.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="ReadingSystemCodingMethodCode" type="ebts:METCodeType" nillable="true">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>An element to describe the degree of automation in the
				characterization process, using the three part MET codes.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="ReadingSystemName" type="niem-xs:string">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>A name of a system used to read minutiae.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="ReadingSystemSubsystemID" type="niem-xs:string">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>An identification of a subsystem system used to read
				minutiae.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordBiometricImageCategoryCode" type="ebts:BiometricImageCategoryCodeType"
		nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element that indicates the type of image included in an electronic
				latent submittal to identify the Type-7 or Type-13 record(s)
				present</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordRapBackData" type="ebts:RecordRapBackDataType">
		<xsd:annotation>
			<xsd:documentation>A logical data record containing rap back fields which provide
				identification and descriptive information associated with the Subscriber's Rap Back
				Subscription(s).</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordRapBackSubscriptionListText" type="nc:TextType">
		<xsd:annotation>
			<xsd:documentation>An element that represents a list of Rap Back Subscriptions that have
				been enrolled into the Rap Back program.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordTransactionActivity" type="ebts:RecordTransactionActivityType">
		<xsd:annotation>
			<xsd:documentation>An element to represent FBI-Specific information used to identify an
				Activity that initiated the transaction.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RepositoryCivilParameterRatio" type="ebts:RatioType">
		<xsd:annotation>
			<xsd:documentation>A percentage that indicates the fraction of the civil files having
				that value of the parameter for a repository response section</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RepositoryCombinedParameterRatio" type="ebts:RatioType">
		<xsd:annotation>
			<xsd:documentation>A percentage that indicates the fraction of the combined criminal and
				civil files having that value of the parameter for a repository response
				section</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordControllingAgencyID" type="niem-xs:string" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An identification that contains the originating agency identifier
				(ORI) of the organization controlling the transaction (CRI)</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RepositoryCriminalParameterRatio" type="ebts:RatioType">
		<xsd:annotation>
			<xsd:documentation>A percentage that indicates the fraction of the criminal files having
				that value of the parameter for a repository response section</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordDisseminationDate" type="niem-xs:date">
		<xsd:annotation>
			<xsd:documentation>A date a record was disseminated.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordFBIRepositoryCode" type="ebts:NDRCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code designation for a biometric repository.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordFeaturesRequestIndicator" type="niem-xs:boolean" nillable="true">
		<xsd:annotation>
			<xsd:documentation>True if user desires to have NGI return a Type-9 features record
				associated with an image requested, false otherwise.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordImageCaptureDetail" type="ebts:ImageCaptureDeviceDetailType"
		nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of the Capture Device Details.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordImagesRequestedQuantity" type="niem-xs:nonNegativeInteger"
		nillable="true">
		<xsd:annotation>
			<xsd:documentation>A number that indicates how many image records are being
				requested.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordLatentRetentionIndicator" type="niem-xs:boolean" nillable="true">
		<xsd:annotation>
			<xsd:appinfo>
				<i:Deprecated i:value="true"/>
			</xsd:appinfo>
			<xsd:documentation>True if the latent record owner requests that the IDENT'ed record be
				retained in the unsolved latent file; false if otherwise.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordPhotoRequestIndicator" type="niem-xs:boolean" nillable="true">
		<xsd:annotation>
			<xsd:documentation>True if user desires to have NGI return a Type-10 photo record if one
				is on file and disseminable, false otherwise.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordPointOfContact" type="ebts:POCType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A 24/7 Point of contact for the
				biometric/identity.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordRapBackActivityNotificationFormatCode" type="ebts:RBNFCodeType"
		nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code indicating the type of rap back activity
				notification</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordRapBackActivityNotificationID" type="niem-xs:string">
		<xsd:annotation>
			<xsd:documentation>An identification for future reported event matches for rap
				back.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordRapBackAttentionText" type="nc:TextType">
		<xsd:annotation>
			<xsd:documentation>Attention information to link future Rap Back Activity Notifications
				to the right person or section within the subscribing entity.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordRapBackCategoryCode" type="ebts:RBCCodeType">
		<xsd:annotation>
			<xsd:documentation>A code indicating the category of the rap back
				subscription.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordRapBackDisclosureIndicator" type="niem-xs:boolean" nillable="true">
		<xsd:annotation>
			<xsd:documentation>True if the Criminal Rap Back Subscription information should be
				included as Identity History Summary information; false
				otherwise.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordRapBackExpirationDate" type="niem-xs:date" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A date a Rap Back Subscription expires under the Subscriber's Privacy
				Strategy.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordRapBackInStateOptOutIndicator" type="niem-xs:boolean" nillable="true">
		<xsd:annotation>
			<xsd:documentation>True if Submitter wishes to opt-out of receiving notifications for
				events originating within the submitter’s own state; false
				otherwise</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordRapBackSubscriptionDate" type="niem-xs:date">
		<xsd:annotation>
			<xsd:documentation>The Date a rap back subscription was created.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordRapBackSubscriptionID" type="niem-xs:string">
		<xsd:annotation>
			<xsd:documentation>Unique number assigned by NGI that identifies a rap back subscription
				as a whole.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordRapBackSubscriptionTerm" type="ebts:RBSubscriptionTermCodeType">
		<xsd:annotation>
			<xsd:documentation>A representation of the length of a Rap Back Subscription
				Term.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordRapBackTermDate" type="niem-xs:date" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A date identifying the end of the fee paid by the
				Subscriber.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordRapBackTriggeringEventCode" type="ebts:RBTCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A code identifying the type of rap back triggering
				event.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordRapBackUserDefinedElement" type="ebts:UserDefinedElementType">
		<xsd:annotation>
			<xsd:documentation>A user-defined element pairing field name and field value
				text.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordRapSheetFormatRequestCode" type="ebts:RapSheetFormatRequestCodeType">
		<xsd:annotation>
			<xsd:documentation>A code to describe the desired format of a rapsheet
				response</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordReceivingAgency" type="nc:IdentificationType">
		<xsd:annotation>
			<xsd:documentation>An agency receiving the transaction record</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordSubject" type="ebts:RecordSubjectType">
		<xsd:annotation>
			<xsd:documentation>An element that contains information used to identify the subject of
				a record transaction.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordTransactionCategoryCode" type="ebts:TOTCodeType">
		<xsd:annotation>
			<xsd:documentation>A kind of code used to describe the purpose of the
				transaction.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RecordTransactionData" type="ebts:RecordTransactionDataType">
		<xsd:annotation>
			<xsd:documentation>A Record Transaction section of an EBTS Record.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RepositoryParameterText" type="nc:TextType">
		<xsd:annotation>
			<xsd:documentation>A description of the parameter name for a repository response
				section</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RepositoryParameterValueText" type="nc:TextType">
		<xsd:annotation>
			<xsd:documentation>A description of the parameter value for a repository response
				section</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="ReturnAllRecordsIndicator" type="niem-xs:boolean" nillable="true">
		<xsd:annotation>
			<xsd:documentation>Indicates whether a search returns all subscriptions that are routed
				through the sending ORI.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="RidgeCoreDelta" type="ebts:RidgeCoreDeltaType">
		<xsd:annotation>
			<xsd:documentation>An element to allow for the representation of FBI specific elements
				for finger pattern and sub-pattern classifications.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<!--s-->

	<xsd:element name="StartDate" type="niem-xs:date">
		<xsd:annotation>
			<xsd:documentation>A local date that supervisory custody began</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="StateDefinedFields" type="ebts:UserDefinedFieldsType"
		substitutionGroup="itl:OtherDescriptiveDetail">
		<xsd:annotation>
			<xsd:documentation>An element to allow for the representation of State-specific data not
				otherwise required by the FBI</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="SupervisedReleaseActionCode" type="ebts:SupervisedReleaseActionCodeType">
		<xsd:annotation>
			<xsd:documentation>A Code to express the supervised release action that should be
				performed on the Subject Record for a particular Arrest</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="SupervisedReleaseRevocationReasonText" type="nc:TextType">
		<xsd:annotation>
			<xsd:documentation>A reason the supervised release is cancelled for a Subject for a
				particular Arrest</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="SupervisionReceivingOrganizationID" type="niem-xs:string">
		<xsd:annotation>
			<xsd:documentation>An identifier containing the ORI for the agency to which supervision
				is being transferred</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="SupervisionStatusCode" type="ebts:SupervisionStatusCodeType">
		<xsd:annotation>
			<xsd:documentation>A status of the supervised release about a Subject for a particular
				Arrest</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="SupervisionStatus" type="ebts:SupervisionStatusType">
		<xsd:annotation>
			<xsd:documentation>A container for the supervised release status information about a
				Subject for a particular Arrest</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<!--t-->
	<xsd:element name="TierLevelCode" type="ebts:TLICodeType">
		<xsd:annotation>
			<xsd:documentation>A code indicating the appropriate level of dissemination for a
				retained identity.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionActionText" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element that includes text answers to submission requests to
				indicate that a latent case will be established or to indicate recommendations for
				further actions in either latent or ten-print responses.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionAuditTrailRecordList" type="ebts:AuditTrailRecordListType"
		nillable="true">
		<xsd:annotation>
			<xsd:documentation>A data type for containing a list of information associated with the
				dissemination of a Record owner's image</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionBiometricImageEnrollmentRecordList"
		type="ebts:BiometricImageEnrollmentRecordListType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A list of information associated with the enrolled biometric
				images</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionBiometricImagesRequested"
		type="ebts:BiometricImageDescriptionListType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A list of requested biometric images.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionCandidateList" type="ebts:TransactionCandidateListType">
		<xsd:annotation>
			<xsd:documentation>A list of candidates given as possible matches to a search
				request.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionCategoryCode" type="ebts:TOTCodeType"
		substitutionGroup="itl:TransactionCategoryAbstract">
		<xsd:annotation>
			<xsd:documentation>An element to indicate the type of transaction defined by receiving
				agency.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionDescriptionText" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A description of additional information regarding electronic
				submissions.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<!--2.075-->
	<xsd:element name="TransactionElectronicRapSheetText" type="nc:TextType">
		<xsd:annotation>
			<xsd:documentation>An element that represents a subject's rap sheet</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<!--2.090-->
	<xsd:element name="TransactionElectronicRapSheetXML" type="nc:TextType">
		<xsd:annotation>
			<xsd:documentation>An element that represents a subject's rap sheet</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionHitCategoryCode" type="ebts:TransactionHitCategoryCodeType">
		<xsd:annotation>
			<xsd:documentation>A kind of identification category for a hit
				response.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionImagesRequestedQuantity" type="niem-xs:nonNegativeInteger"
		nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element that contains the maximum number of candidates the
				submitter desires to receive in response to a search. If the field is left blank,
				only images for the highest scoring candidate will be returned.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionFingerprintImagesRequested"
		type="ebts:TransactionFingerprintImagesType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element that contains the finger numbers for which image
				information is requested, used in transactions involving a request for fingerprint
				image information.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionFingerprintImagesUpdated"
		type="ebts:TransactionFingerprintImagesType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element that contains the finger positions that were updated in
				the FBI’s Fingerprint Image Master File as a result of an electronic request to
				update fingerprint images.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionMaintenanceActionCode" type="ebts:MaintenanceActionCodeType">
		<xsd:annotation>
			<xsd:documentation>A code to indicate what maintenance operation is being requested in a
				maintenance type transaction</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionPenetrationQueryResponsePercent" type="ebts:PercentageType"
		nillable="true">
		<xsd:annotation>
			<xsd:documentation>A response to the penetration query that includes the size, in
				percentage of the repository that will be searched.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TransactionReasonText" type="nc:TextType">
		<xsd:annotation>
			<xsd:documentation>An explanation of a transaction response</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionRapBackMaintenanceCode" type="ebts:RBMICodeType">
		<xsd:annotation>
			<xsd:documentation>A code indicating the type of maintenance action being requested for
				a Rap Back Maintenance Request.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionRapBackTriggeringEvent" type="ebts:RapBackTriggeringEventType">
		<xsd:annotation>
			<xsd:documentation>An event that triggered a Rap Back Notification.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionResponseData" type="ebts:TransactionResponseDataType">
		<xsd:annotation>
			<xsd:documentation>An element that contains response information to a EBTS
				Transaction.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionResponseIndicator" type="niem-xs:boolean" nillable="true">
		<xsd:annotation>
			<xsd:documentation>True if the request contains no errors, false otherwise. This field
				is used in the PDR and PRR transactions to indicate the status of the corresponding
				request.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionRepositoryResponse" type="ebts:TransactionRepositoryResponseType">
		<xsd:annotation>
			<xsd:documentation>An element that holds statistics that can be used to estimate the
				level of penetration of the repository given a set of search parameters defined in
				the search request</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionRepositoryResponseRecord"
		type="ebts:TransactionRepositoryResponseRecordType">
		<xsd:annotation>
			<xsd:documentation>An element that details statistics that can be used to estimate the
				level of penetration of the repository given a set of search parameters defined in
				the search request</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionSearchAreaCode" type="ebts:GeographicAreaCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element that indicates the geographic area to be
				searched.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionSearchResultsCode" type="ebts:SRFCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element that indicates the identification results of a biometric
				search.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionSearchRequestCategoryCode" type="ebts:TSRCodeType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element that indicates the type of record being
				submitted.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionStatusText" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>An element that contains reason, status or error messages that are
				generated as a result of the processing of a transaction.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionSubmissionMilitaryCode" type="ebts:MilitaryBranchCodeType"
		nillable="true">
		<xsd:annotation>
			<xsd:documentation>A branch of the United States Military that submitted the enlistment
				transaction</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionSupplementaryIdentityInformationText" type="nc:TextType">
		<xsd:annotation>
			<xsd:documentation>An element to allow inclusion of additional identity information
				regarding a subject</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="TransactionUnsolvedLatentFileIndicator" type="niem-xs:boolean"
		nillable="true">
		<xsd:annotation>
			<xsd:documentation>True if latent image or features record in search should be added to
				or retained in the Unsolved Latent File, otherwise false.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="Type10UserDefinedFields" type="ebts:UserDefinedFaceInformationType"
		substitutionGroup="itl:UserDefinedFields">
		<xsd:annotation>
			<xsd:documentation>A user-defined field to contain additional Type-10 data elements
				required by EBTS that are not defined in the ANSI/NIST-ITL standard</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="Type14UserDefinedFields" type="ebts:UserDefinedFrictionRidgeInformationType"
		substitutionGroup="itl:UserDefinedFields">
		<xsd:annotation>
			<xsd:documentation>A user-defined field to contain additional Type-14 data elements
				required by EBTS that are not defined in the ANSI/NIST-ITL
				standard</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="Type15UserDefinedFields" type="ebts:UserDefinedFrictionRidgeInformationType"
		substitutionGroup="itl:UserDefinedFields">
		<xsd:annotation>
			<xsd:documentation>A user-defined field to contain additional Type-15 data elements
				required by EBTS that are not defined in the ANSI/NIST-ITL
				standard</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<!--u-->
	<xsd:element name="UserDefinedElementName" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A name of a user-defined element.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:element name="UserDefinedElementText" type="nc:TextType" nillable="true">
		<xsd:annotation>
			<xsd:documentation>A user-defined element value.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<!--v-->
	<!--w-->
	<!--x-->
	<!--y-->
	<!--z-->
</xsd:schema>
